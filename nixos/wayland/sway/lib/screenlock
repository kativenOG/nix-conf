# ScreenLock
bindsym $mod+Shift+Escape exec "swaylock -f -i ~/nix-conf/nixos/wayland/sway/lib/img/screenlock_bg.png -n -r --indicator-x-position 100 --indicator-y-position 100 --ring-color 000000ff"
# Suspend the laptop (suspend to memory)
bindsym $mod+Ctrl+Escape exec "swaylock -f -i ~/nix-conf/nixos/wayland/sway/lib/img/screenlock_bg.png -n -r --indicator-x-position 100 --indicator-y-position 100 --ring-color 000000ff && systemctl suspend"
# Hibernate the laptop (suspend to disk)
bindsym $mod+Shift+i exec "swaylock -f -i ~/nix-conf/nixos/wayland/sway/lib/img/screenlock_bg.png -n -r --indicator-x-position 100 --indicator-y-position 100 --ring-color 000000ff && systemctl hibernate" 

# Automatic lock/sleep with swayidle
# DPMS=Display Power Management System, lets you turn on or off the screen without suspending the laptop (suspend to idle)
exec swayidle -w \
     timeout 90 'swaylock -f -i ~/nix-conf/nixos/wayland/sway/lib/img/screenlock_bg.png -n  -r --indicator-x-position 100 --indicator-y-position 100 --ring-color 000000ff' \
     timeout 180 'swaymsg "output * dpms off"' \
     resume 'swaymsg "output * dpms on"' \
		 timeout 300 'systemctl suspend ' \
     before-sleep 'swaylock -f -i ~/nix-conf/nixos/wayland/sway/lib/img/screenlock_bg.png -n  -r --indicator-x-position 100 --indicator-y-position 100 --ring-color 000000ff'	
