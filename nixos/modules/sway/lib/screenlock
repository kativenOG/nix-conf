# ScreenLock
bindsym $mod+Shift+Escape exec "swaylock -f -i ~/nix-conf/nixos/modules/sway/lib/img/screenlock_bg.png -n -r --indicator-x-position 100 --indicator-y-position 100 --ring-color 000000ff"
# Suspend the laptop (suspend to memory)
bindsym $mod+Ctrl+Escape exec "swaylock -f -i ~/nix-conf/nixos/modules/sway/lib/img/screenlock_bg.png -n -r --indicator-x-position 100 --indicator-y-position 100 --ring-color 000000ff && systemctl suspend"
# Hibernate the laptop (suspend to disk)
bindsym $mod+Shift+i exec "swaylock -f -i ~/nix-conf/nixos/modules/sway/lib/img/screenlock_bg.png -n -r --indicator-x-position 100 --indicator-y-position 100 --ring-color 000000ff && systemctl hibernate" 

